# Normaliza finales de línea. Por defecto LF, con independencia de la
# configuración local de core.autocrlf de quien haga el checkout.
#
# Esto no es cosmético en este repositorio: los seis entrypoints de
# stacks/workloads/config/ son el PID 1 de los servicios de producción y se
# entregan al contenedor como Docker Config, byte a byte. Un CRLF en la línea
# del shebang haría que el kernel buscase un intérprete llamado "/bin/sh\r",
# que no existe, y el servicio no arrancaría.
#
# Hoy el índice está limpio (git ls-files --eol devuelve i/lf en los 336
# ficheros). Este fichero garantiza que siga estándolo aunque alguien
# contribuya desde Windows con core.autocrlf=false.
* text=auto eol=lf

# Scripts POSIX: SIEMPRE LF.
*.sh text eol=lf

# Ficheros ejecutables o de unidad sin extensión.
ansible/roles/platform/files/dockerswarm-swarm-unlock text eol=lf
config/logrotate/iptables text eol=lf

# Código, plantillas y configuración: LF.
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.j2   text eol=lf
*.tf   text eol=lf
*.hcl  text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.conf text eol=lf
*.md   text eol=lf
*.in   text eol=lf
*.txt  text eol=lf
*.pem  text eol=lf
*.example text eol=lf
*.allowed-signers text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.path    text eol=lf
*.tfbackend text eol=lf
*.tfvars  text eol=lf
