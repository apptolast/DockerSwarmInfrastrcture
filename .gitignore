.env
.env.*
!.env.example
.ansible/
.build/
.terraform.d/
.tools/
.venv/
*.key
*.pem
# Anclas de confianza publicas de Let's Encrypt staging. No son material
# secreto (cuatro raices autofirmadas, cero claves privadas) y
# tests/test_edge_state_safety.py fija su sha256, asi que deben viajar en el
# commit: sin ellas la reconstruccion pierde el bundle anclado y CI falla.
!ansible/roles/edge/files/letsencrypt-staging-roots.pem
*.swp
*.tmp
*.backup.*
__pycache__/
*.pyc

# Ansible runtime inputs and retry artifacts.
ansible/inventory/production/group_vars/vault.yml
ansible/inventory/**/group_vars/vault.yml
ansible/inventory/**/host_vars/
.vault-password*
*.vault
*.retry

# Terraform local cache, state, plans and backend credentials.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars.json
*.tfvars
!*.tfvars.example
*.tfbackend
!*.tfbackend.example
crash.log
crash.*.log
.terraformrc
terraform.rc

# Additional credential and private-key containers.
*.p12
*.pfx
*.age
*.secret
*.token
