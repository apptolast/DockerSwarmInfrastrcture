logging {
  level  = "info"
  format = "json"
}

discovery.docker "local" {
  host             = "unix:///run/docker-readonly/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "managed_containers" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_swarm_service_name",
    ]
    regex  = "(edge|workloads|observability)_.+"
    action = "keep"
  }

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_swarm_service_name",
    ]
    target_label = "swarm_service"
  }

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_stack_namespace",
    ]
    target_label = "swarm_stack"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }
}

loki.source.docker "managed" {
  host             = "unix:///run/docker-readonly/docker.sock"
  targets          = discovery.relabel.managed_containers.output
  labels           = {
    environment = "production",
    platform    = "apptolast",
    source      = "docker",
  }
  refresh_interval = "15s"
  forward_to       = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
