---
global:
  scrape_interval: 30s
  scrape_timeout: 10s
  evaluation_interval: 30s
  external_labels:
    environment: "{{ platform_environment }}"
    platform: apptolast

rule_files:
  - /etc/prometheus/rules/platform.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - prometheus:9090

  - job_name: alertmanager
    static_configs:
      - targets:
          - alertmanager:9093

  - job_name: blackbox-exporter
    static_configs:
      - targets:
          - blackbox-exporter:9115

  - job_name: loki
    static_configs:
      - targets:
          - loki:3100

  - job_name: alloy
    static_configs:
      - targets:
          - tasks.alloy:12345

  - job_name: grafana
    metrics_path: /metrics
    static_configs:
      - targets:
          - grafana:3000

  - job_name: node-exporter
    dns_sd_configs:
      - names:
          - tasks.node-exporter
        type: A
        port: 9100
        refresh_interval: 30s

  - job_name: cadvisor
    dns_sd_configs:
      - names:
          - tasks.cadvisor
        type: A
        port: 8080
        refresh_interval: 30s

  - job_name: postgres-exporter-n8n
    static_configs:
      - targets:
          - postgres-exporter-n8n:9187

  - job_name: postgres-exporter-passbolt
    static_configs:
      - targets:
          - postgres-exporter-passbolt:9187

  - job_name: postgres-exporter-shlink
    static_configs:
      - targets:
          - postgres-exporter-shlink:9187

  - job_name: redis-exporter
    static_configs:
      - targets:
          - redis-exporter:9121

  - job_name: traefik
    static_configs:
      - targets:
          - edge_traefik:8082

  - job_name: n8n
    metrics_path: /metrics
    static_configs:
      - targets:
          - workloads_n8n:5678

  - job_name: blackbox-http-public
    metrics_path: /probe
    params:
      module:
        - http_success
    static_configs:
      - targets:
{% for target in observability_public_probe_targets %}
          - "{{ target }}"
{% endfor %}
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: blackbox-minecraft-tcp
    metrics_path: /probe
    params:
      module:
        - tcp_connect
    static_configs:
      - targets:
          - workloads_minecraft:25565
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
