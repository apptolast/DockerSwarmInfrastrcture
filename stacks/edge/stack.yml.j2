version: "3.8"

services:
  traefik:
    image: "{{ image_channels_map.edge['traefik'].reference }}"
    user: "{{ edge_traefik_runtime_uid }}:{{ edge_traefik_runtime_gid }}"
    command:
      - --configFile=/etc/traefik.yml
    environment:
      CF_DNS_API_TOKEN_FILE: /run/secrets/cloudflare_dns_api_token
    ports:
      - target: 8000
        published: 80
        protocol: tcp
        mode: host
      - target: 8443
        published: 443
        protocol: tcp
        mode: host
    configs:
      - source: traefik_static
        target: /etc/traefik.yml
        uid: "{{ edge_traefik_runtime_uid }}"
        gid: "{{ edge_traefik_runtime_gid }}"
        mode: 0444
      - source: traefik_dynamic
        target: /etc/traefik-dynamic.yml
        uid: "{{ edge_traefik_runtime_uid }}"
        gid: "{{ edge_traefik_runtime_gid }}"
        mode: 0444
    volumes:
      - type: bind
        source: "{{ edge_state_root }}/traefik"
        target: /data
      # The access log CrowdSec tails (docs/EDGE.md, "Log de acceso en
      # fichero"): a root-owned directory holding one file the runtime user
      # may only append to.
      - type: bind
        source: "{{ edge_traefik_access_log_dir }}"
        target: /var/log/traefik
    secrets:
      - source: cloudflare_dns_api_token
        target: cloudflare_dns_api_token
        uid: "{{ edge_traefik_runtime_uid }}"
        gid: "{{ edge_traefik_runtime_gid }}"
        mode: 0400
{% for secret_target in edge_traefik_basicauth_secrets | sort %}
      - source: {{ secret_target }}
        target: {{ secret_target }}
        uid: "{{ edge_traefik_runtime_uid }}"
        gid: "{{ edge_traefik_runtime_gid }}"
        mode: 0400
{% endfor %}
{% for secret_target in edge_traefik_upstream_mtls_secrets | sort %}
      - source: {{ secret_target }}
        target: {{ secret_target }}
        uid: "{{ edge_traefik_runtime_uid }}"
        gid: "{{ edge_traefik_runtime_gid }}"
        mode: 0400
{% endfor %}
    networks:
{% for network_key in edge_networks | combine(edge_application_networks) %}
      - edge-{{ network_key }}
{% endfor %}
      - edge-monitoring
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777,noexec,nosuid,nodev
    cap_drop:
      - ALL
    stop_grace_period: 30s
    healthcheck:
      test:
        - CMD
        - traefik
        - healthcheck
        - --configFile=/etc/traefik.yml
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: local
      options:
        max-file: "5"
        max-size: 20m
    deploy:
      mode: replicated
      replicas: 1
      labels:
        apptolast.autoupdate: "{{ image_channels_map.edge['traefik'].label }}"
      placement:
        constraints:
          - node.role == manager
          - node.labels.platform.edge == true
      resources:
        limits:
          cpus: "0.50"
          # The traefik binary is ~185 MB. At 128M its file pages were
          # reclaimed nonstop, `traefik healthcheck` timed out and Swarm
          # replaced the task every few minutes (2026-09-25).
          memory: 256M
        reservations:
          cpus: "0.10"
          memory: 128M
      restart_policy:
        condition: any
        delay: 5s
        window: 60s
      update_config:
        parallelism: 1
        delay: 10s
        order: stop-first
        failure_action: rollback
        monitor: 90s
        max_failure_ratio: 0
      rollback_config:
        parallelism: 1
        delay: 5s
        order: stop-first
        failure_action: pause
        monitor: 90s
        max_failure_ratio: 0

networks:
{% for network_key, network_name in (edge_networks | combine(edge_application_networks)).items() %}
  edge-{{ network_key }}:
    external: true
    name: "{{ network_name }}"
{% endfor %}
  edge-monitoring:
    external: true
    name: "{{ edge_monitoring_network }}"

secrets:
  cloudflare_dns_api_token:
    external: true
    name: "{{ edge_traefik_cloudflare_secret_name }}"
{% for secret_target, secret_name in edge_traefik_basicauth_secrets | dictsort %}
  {{ secret_target }}:
    external: true
    name: "{{ secret_name }}"
{% endfor %}
{% for secret_target, secret_name in edge_traefik_upstream_mtls_secrets | dictsort %}
  {{ secret_target }}:
    external: true
    name: "{{ secret_name }}"
{% endfor %}

configs:
  traefik_static:
    external: true
    name: "{{ edge_traefik_static_config_name }}"
  traefik_dynamic:
    external: true
    name: "{{ edge_traefik_dynamic_config_name }}"
