global:
  checkNewVersion: false
  sendAnonymousUsage: false

api:
  dashboard: false
  insecure: false

entryPoints:
  web:
    address: ":8000"
    http:
      encodedCharacters:
        allowEncodedBackSlash: false
        allowEncodedHash: false
        allowEncodedNullCharacter: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedSemicolon: false
        allowEncodedSlash: false
      underscoreHeadersStrategy: reject
      redirections:
        entryPoint:
          to: ":443"
          scheme: https
          permanent: true
  websecure:
    address: ":8443"
    http:
      encodedCharacters:
        allowEncodedBackSlash: false
        allowEncodedHash: false
        allowEncodedNullCharacter: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedSemicolon: false
        allowEncodedSlash: false
      underscoreHeadersStrategy: reject
      tls:
        certResolver: letsencrypt
    transport:
      respondingTimeouts:
        # readTimeout bounds the WHOLE request, and Go leaves that
        # deadline on a connection hijacked for a WebSocket, so the
        # 60s default cut every upgraded connection after a minute.
        # An hour keeps a slow-body bound while letting a game or a
        # push channel live. writeTimeout: 0s is Traefik's default.
        readTimeout: 3600s
        writeTimeout: 0s
        idleTimeout: 180s
  traefik:
    address: ":8080"
    http:
      encodedCharacters:
        allowEncodedBackSlash: false
        allowEncodedHash: false
        allowEncodedNullCharacter: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedSemicolon: false
        allowEncodedSlash: false
      underscoreHeadersStrategy: reject
  metrics:
    address: ":8082"
    http:
      encodedCharacters:
        allowEncodedBackSlash: false
        allowEncodedHash: false
        allowEncodedNullCharacter: false
        allowEncodedPercent: false
        allowEncodedQuestionMark: false
        allowEncodedSemicolon: false
        allowEncodedSlash: false
      underscoreHeadersStrategy: reject

# manualRouting desactiva el router interno por defecto, que es el requisito
# para que el router edge-health de dynamic.yml pueda referenciar
# ping@internal como servicio propio.
ping:
  entryPoint: traefik
  manualRouting: true

providers:
  file:
    filename: /etc/traefik-dynamic.yml
    watch: false

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ edge_traefik_acme_email }}"
      storage: "/data/{{ edge_traefik_acme_storage_filename }}"
      caServer: "{{ edge_traefik_acme_ca_server }}"
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"

metrics:
  addInternals: true
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true

log:
  level: INFO
  format: json

accessLog:
  # En el host, por el bind mount de /var/log/traefik, para que CrowdSec lo
  # lea como un fichero y nunca por la API de Docker (docs/EDGE.md, "Log de
  # acceso en fichero"). Traefik lo abre con O_APPEND y no lo reabre solo:
  # el rol edge lo rota con logrotate copytruncate, sin senal.
  filePath: /var/log/traefik/access.log
  format: json
  bufferingSize: 100
  fields:
    # basicAuth anota en ClientUsername lo que se escriba como usuario,
    # tambien si el login falla: una contrasena tecleada en ese campo
    # acabaria en el log de acceso.
    names:
      ClientUsername: drop
    queryParameters:
      defaultMode: drop
    headers:
      defaultMode: drop

serversTransport:
  forwardingTimeouts:
    dialTimeout: 10s
    responseHeaderTimeout: 60s
    idleConnTimeout: 180s
