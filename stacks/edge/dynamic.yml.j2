{% set kropia = approved_services | selectattr("id", "equalto", "kropia") | first %}
{% set minecraft_stats = approved_services | selectattr("id", "equalto", "minecraft-stats") | first %}
{% set n8n = approved_services | selectattr("id", "equalto", "n8n") | first %}
{% set openclaw = approved_services | selectattr("id", "equalto", "openclaw-clean") | first %}
{% set passbolt = approved_services | selectattr("id", "equalto", "passbolt") | first %}
{% set pablo = approved_services | selectattr("id", "equalto", "personal-website-pablo") | first %}
{% set alberto = approved_services | selectattr("id", "equalto", "personal-website-alberto") | first %}
{% set shlink = approved_services | selectattr("id", "equalto", "shlink") | first %}
http:
  routers:
    edge-health:
      rule: "Host(`{{ edge_traefik_hostname }}`) && Path(`/ping`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
        - edge-rate-limit
      service: ping@internal
      tls:
        certResolver: letsencrypt
    # ping.manualRouting desactiva el router interno por defecto de Traefik,
    # asi que este router explicito es el que atiende `traefik healthcheck`,
    # que consulta /ping sobre el entryPoint interno. Sin el, el healthcheck
    # del contenedor recibe 404 y Swarm mata el edge completo.
    edge-ping-internal:
      rule: "Path(`/ping`)"
      entryPoints:
        - traefik
      service: ping@internal
    kropia:
      rule: "Host(`{{ kropia.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: kropia
      tls:
        certResolver: letsencrypt
    minecraft-stats:
      rule: "Host(`{{ minecraft_stats.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: minecraft-stats
      tls:
        certResolver: letsencrypt
    n8n:
      rule: "Host(`{{ n8n.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: n8n
      tls:
        certResolver: letsencrypt
    openclaw:
      rule: "Host(`{{ openclaw.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: openclaw
      tls:
        certResolver: letsencrypt
    passbolt:
      rule: "Host(`{{ passbolt.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - passbolt-security
      service: passbolt
      tls:
        certResolver: letsencrypt
    portfolio-pablo:
      rule: "Host(`{{ pablo.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: portfolio-pablo
      tls:
        certResolver: letsencrypt
    portfolio-alberto:
      rule: "Host(`{{ alberto.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: portfolio-alberto
      tls:
        certResolver: letsencrypt
    shlink:
      rule: "Host(`{{ shlink.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: shlink
      tls:
        certResolver: letsencrypt

    organizationweb:
      rule: "Host(`{{ organizationweb.hostname }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
        - edge-rate-limit
      service: organizationweb
      tls:
        certResolver: letsencrypt
    racinggame:
      rule: "Host(`{{ racinggame.hostname }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: racinggame
      tls:
        certResolver: letsencrypt
    # The monitoring dashboard is deployed outside this repository. Its
    # route is codified here so a reviewed edge apply reproduces the
    # running state instead of deleting it.
    monitorizacion:
      rule: "Host(`monitor.apptolast.com`)"
      entryPoints:
        - websecure
      service: monitorizacion
      tls:
        certResolver: letsencrypt
    # Satisfactory se despliega fuera de este repositorio (Compose
    # `satisfactory` y stack `satisfactory-companions`). Sus rutas se
    # codificaron tal como corrian en la Docker Config hecha a mano
    # `edge-traefik-dynamic-companions-a0952eace071`, sin `edge-rate-limit`.
    # Las prioridades explicitas hacen que `/app/` (websocket de Reverb) y
    # `/companions` ganen a la ruta general del mismo host.
    satisfactory-web:
      rule: "Host(`satisfactory.apptolast.com`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: satisfactory-web
      tls:
        certResolver: letsencrypt
    satisfactory-ws:
      rule: "Host(`satisfactory.apptolast.com`) && PathPrefix(`/app/`)"
      priority: 100
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: satisfactory-reverb
      tls:
        certResolver: letsencrypt
    satisfactory-companions:
      rule: >-
        Host(`satisfactory.apptolast.com`) && (Path(`/companions`) ||
        PathPrefix(`/companions/`))
      priority: 120
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: satisfactory-companions
      tls:
        certResolver: letsencrypt
    satisfactory-logs:
      rule: "Host(`logs-satisfactory.apptolast.com`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
        - satisfactory-log-auth
      service: satisfactory-logs
      tls:
        certResolver: letsencrypt
    # Panel web de AX (laboratorio kind, fuera de Swarm). `ax-server` no se
    # publica nunca. `ax-canonical-host` va primero para que los limites
    # agrupen por un unico Host, y los limites van antes del basicAuth, que
    # cuesta un bcrypt por peticion con credenciales. Sin `edge-compress` ni
    # `edge-default`: compress retiene los primeros bytes de la salida en
    # directo (SSE) del panel.
    ax:
      rule: "Host(`ax.apptolast.com`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
        - ax-canonical-host
        - ax-rl-ip
        - ax-rl-host
        - ax-inflight
        - ax-auth
      service: ax
      tls:
        certResolver: letsencrypt
    # Unica peticion sin credenciales: `GET /healthz` del panel, que solo
    # responde `ok`. Atraviesa Traefik, el reenviador y el mTLS, asi que un
    # `200` prueba la cadena entera; cualquier otro metodo o ruta cae en el
    # router `ax` y su basicAuth. Sin basicAuth que la quite, la cabecera
    # Authorization que el navegador reenvia por su cuenta se borra aqui.
    ax-health:
      rule: "Host(`ax.apptolast.com`) && Path(`/healthz`) && Method(`GET`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
        - ax-canonical-host
        - ax-rl-ip
        - ax-rl-host
        - ax-inflight
        - ax-strip-authorization
      service: ax
      tls:
        certResolver: letsencrypt
  middlewares:
    edge-security:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        stsSeconds: 31536000
        customResponseHeaders:
          Server: ""
    edge-rate-limit:
      rateLimit:
        average: 20
        burst: 40
        period: 1s
    edge-compress:
      compress: {}
    edge-default:
      chain:
        middlewares:
          - edge-security
          - edge-compress
    passbolt-forwarded-proto:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: https
        customResponseHeaders:
          X-Robots-Tag: "noindex, nofollow"
    passbolt-security:
      chain:
        middlewares:
          - passbolt-forwarded-proto
          - edge-security
    # El fichero de usuarios (`usuario:hash-bcrypt`) es un Docker Secret que
    # solo existe en el host; ningun hash entra en este repositorio publico.
    # Sin clave `users`: Traefik la antepone a `usersFile`. Si el fichero
    # falta o esta vacio, Traefik desactiva solo este router (404).
    satisfactory-log-auth:
      basicAuth:
        usersFile: /run/secrets/basicauth_satisfactory_logs
        realm: Satisfactory logs
        removeHeader: true
    # `requestHost` agrupa por el Host crudo de la peticion, no por el que
    # normaliza el router: sin esto, `AX.apptolast.com` o
    # `ax.apptolast.com:443` entran en `ax` con contadores nuevos cada uno.
    # Traefik cambia el Host antes de llamar al siguiente middleware; el
    # panel solo compara Origin.
    ax-canonical-host:
      headers:
        customRequestHeaders:
          Host: ax.apptolast.com
    # Un rateLimit retiene hasta 0,5 s la peticion que admite con retraso;
    # por eso los dos van antes que inFlightReq, para que esa espera no
    # ocupe una de sus plazas. Cada router tiene sus propios contadores.
    # Traefik olvida el contador de una fuente tras 3 s sin peticiones (2 s
    # en el de host) y el siguiente empieza con la rafaga llena: el tope real
    # es unas 30 peticiones cada 2-3 s por IP y unas 10 cada 1-2 s para todo
    # el host, no 30 por minuto ni 2 por segundo (docs/EDGE.md, «Ruta de
    # AX»). Una rafaga menor corta la carga de una pagina del panel.
    ax-rl-ip:
      rateLimit:
        average: 30
        period: 1m
        burst: 30
        sourceCriterion:
          ipStrategy:
            ipv6Subnet: 64
    # Un solo contador para todo el host, gracias a `ax-canonical-host`, sea
    # cual sea la IP: acota el bcrypt a unas 10 peticiones cada 1-2 s.
    ax-rl-host:
      rateLimit:
        average: 2
        period: 1s
        burst: 10
        sourceCriterion:
          requestHost: true
    # Sin sourceCriterion, inFlightReq agrupa por Host, ya canonico: como
    # mucho 8 peticiones a la vez en el router, flujos SSE abiertos incluidos.
    ax-inflight:
      inFlightReq:
        amount: 8
    # Igual que `satisfactory-log-auth`: el fichero de usuarios es un Docker
    # Secret que solo existe en el host, y sin clave `users`. removeHeader
    # quita la cabecera Authorization antes del panel.
    ax-auth:
      basicAuth:
        usersFile: /run/secrets/basicauth_ax
        realm: AX
        removeHeader: true
    # Para `ax-health`, que no pasa por basicAuth: un valor vacio borra la
    # cabecera, asi que el panel nunca recibe Authorization.
    ax-strip-authorization:
      headers:
        customRequestHeaders:
          Authorization: ""

  services:
    # passHostHeader is load bearing: /info builds the phone-controller
    # URL from the Host header, so without it the qr would point at the
    # internal Swarm name and no phone could reach it.
    racinggame:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://racinggame_web:3000
        healthCheck:
          path: /info
          interval: 15s
          timeout: 3s
    monitorizacion:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://monitor-api:8080
    satisfactory-web:
      loadBalancer:
        servers:
          - url: http://satisfactory-web:80
    satisfactory-reverb:
      loadBalancer:
        servers:
          - url: http://satisfactory-reverb:8080
    satisfactory-companions:
      loadBalancer:
        servers:
          - url: http://satisfactory-companions_web:8080
    satisfactory-logs:
      loadBalancer:
        servers:
          - url: http://satisfactory-logs:8080
    # El reenviador TCP `ax-web-edge` (contenedor suelto en la red
    # `apptolast-edge-ax` y en la de kind) lleva la conexion TLS intacta
    # hasta el panel. Sin healthCheck: con el panel parado, la ruta responde
    # 502 despues del login y Traefik no registra un WARN en cada intervalo.
    ax:
      loadBalancer:
        passHostHeader: true
        serversTransport: ax-web-mtls
        servers:
          - url: https://ax-web-edge:8443
    organizationweb:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://organizationweb_web:8080
        healthCheck:
          path: /healthz
          hostname: "{{ organizationweb.hostname }}"
          interval: 15s
          timeout: 3s
    kropia:
      loadBalancer:
        servers:
          - url: http://workloads_kropia:80
        healthCheck:
          path: /health
          interval: 15s
          timeout: 3s
    minecraft-stats:
      loadBalancer:
        servers:
          - url: http://workloads_minecraft-stats:8080
        healthCheck:
          path: /actuator/health
          # El nombre DNS del servicio en Swarm es `workloads_minecraft-stats`
          # y Traefik reutiliza el host de `url` como cabecera Host de la
          # sonda. El Tomcat embebido de Spring Boot aplica RFC 1123 y
          # rechaza con 400 cualquier Host con guion bajo, de modo que la
          # sonda fallaba siempre, Traefik marcaba caido el unico backend y
          # la ruta publica devolvia 503 "no available server" aunque el
          # contenedor estuviese sano. `hostname` fija un Host valido sin
          # tocar el destino de la conexion. Es el unico backend afectado:
          # el resto responde 2xx/3xx con el Host con guion bajo.
          hostname: "{{ minecraft_stats.hostnames | first }}"
          interval: 15s
          timeout: 3s
    n8n:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://workloads_n8n:5678
        healthCheck:
          path: /healthz
          interval: 15s
          timeout: 3s
    openclaw:
      loadBalancer:
        passHostHeader: true
{% if "openclaw" in platform_parked_workloads %}
        # Aparcado (config/platform.yml platform_parked_workloads): sin
        # servidores Traefik responde 503 "no available server" y no lanza la
        # sonda de salud, que sin tarea fallaria y registraria un WARN
        # "Health check failed." cada 15 s. La ruta y su certificado siguen.
        servers: []
{% else %}
        servers:
          - url: http://workloads_openclaw:18789
        healthCheck:
          path: /readyz
          interval: 15s
          timeout: 3s
{% endif %}
    passbolt:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://workloads_passbolt:80
    portfolio-pablo:
      loadBalancer:
        servers:
          - url: http://workloads_portfolio-pablo:3000
        healthCheck:
          path: /
          interval: 15s
          timeout: 3s
    portfolio-alberto:
      loadBalancer:
        servers:
          - url: http://workloads_portfolio-alberto:3000
        healthCheck:
          path: /
          interval: 15s
          timeout: 3s
    shlink:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://workloads_shlink:8080
        healthCheck:
          path: /rest/health
          interval: 15s
          timeout: 3s

  # mTLS de Traefik al panel de AX. Traefik solo acepta el certificado
  # `ax-web` de la CA privada del panel, y el panel solo acepta TLS 1.3 con
  # el certificado cliente `edge-traefik` de esa CA. El PEM cliente lleva
  # certificado y clave. Traefik v3.7.13 compara minVersion con maxVersion
  # aunque maxVersion falte (vale 0): descarta la configuracion TLS del
  # transporte y conecta sin certificado cliente. Por eso van los dos. Un
  # transporte con nombre no hereda los forwardingTimeouts estaticos.
  serversTransports:
    ax-web-mtls:
      serverName: ax-web
      rootCAs:
        - /run/secrets/ax_upstream_ca
      certificates:
        - certFile: /run/secrets/ax_upstream_client
          keyFile: /run/secrets/ax_upstream_client
      minVersion: VersionTLS13
      maxVersion: VersionTLS13
      forwardingTimeouts:
        dialTimeout: 5s
        responseHeaderTimeout: 60s
        idleConnTimeout: 180s

tls:
  options:
    default:
      minVersion: VersionTLS12
      sniStrict: true
