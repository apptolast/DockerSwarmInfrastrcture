{% set kropia = approved_services | selectattr("id", "equalto", "kropia") | first %}
{% set minecraft_stats = approved_services | selectattr("id", "equalto", "minecraft-stats") | first %}
{% set n8n = approved_services | selectattr("id", "equalto", "n8n") | first %}
{% set openclaw = approved_services | selectattr("id", "equalto", "openclaw-clean") | first %}
{% set passbolt = approved_services | selectattr("id", "equalto", "passbolt") | first %}
{% set pablo = approved_services | selectattr("id", "equalto", "personal-website-pablo") | first %}
{% set alberto = approved_services | selectattr("id", "equalto", "personal-website-alberto") | first %}
{% set shlink = approved_services | selectattr("id", "equalto", "shlink") | first %}
http:
  routers:
    edge-health:
      rule: "Host(`{{ edge_traefik_hostname }}`) && Path(`/ping`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
        - edge-rate-limit
      service: ping@internal
      tls:
        certResolver: letsencrypt
    # ping.manualRouting desactiva el router interno por defecto de Traefik,
    # asi que este router explicito es el que atiende `traefik healthcheck`,
    # que consulta /ping sobre el entryPoint interno. Sin el, el healthcheck
    # del contenedor recibe 404 y Swarm mata el edge completo.
    edge-ping-internal:
      rule: "Path(`/ping`)"
      entryPoints:
        - traefik
      service: ping@internal
    kropia:
      rule: "Host(`{{ kropia.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: kropia
      tls:
        certResolver: letsencrypt
    minecraft-stats:
      rule: "Host(`{{ minecraft_stats.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: minecraft-stats
      tls:
        certResolver: letsencrypt
    n8n:
      rule: "Host(`{{ n8n.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: n8n
      tls:
        certResolver: letsencrypt
    openclaw:
      rule: "Host(`{{ openclaw.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-security
      service: openclaw
      tls:
        certResolver: letsencrypt
    passbolt:
      rule: "Host(`{{ passbolt.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - passbolt-security
      service: passbolt
      tls:
        certResolver: letsencrypt
    portfolio-pablo:
      rule: "Host(`{{ pablo.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: portfolio-pablo
      tls:
        certResolver: letsencrypt
    portfolio-alberto:
      rule: "Host(`{{ alberto.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: portfolio-alberto
      tls:
        certResolver: letsencrypt
    shlink:
      rule: "Host(`{{ shlink.hostnames | first }}`)"
      entryPoints:
        - websecure
      middlewares:
        - edge-default
      service: shlink
      tls:
        certResolver: letsencrypt

  middlewares:
    edge-security:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        stsSeconds: 31536000
        customResponseHeaders:
          Server: ""
    edge-rate-limit:
      rateLimit:
        average: 20
        burst: 40
        period: 1s
    edge-compress:
      compress: {}
    edge-default:
      chain:
        middlewares:
          - edge-security
          - edge-compress
    passbolt-forwarded-proto:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: https
        customResponseHeaders:
          X-Robots-Tag: "noindex, nofollow"
    passbolt-security:
      chain:
        middlewares:
          - passbolt-forwarded-proto
          - edge-security

  services:
    kropia:
      loadBalancer:
        servers:
          - url: http://workloads_kropia:80
        healthCheck:
          path: /health
          interval: 15s
          timeout: 3s
    minecraft-stats:
      loadBalancer:
        servers:
          - url: http://workloads_minecraft-stats:8080
        healthCheck:
          path: /actuator/health
          # El nombre DNS del servicio en Swarm es `workloads_minecraft-stats`
          # y Traefik reutiliza el host de `url` como cabecera Host de la
          # sonda. El Tomcat embebido de Spring Boot aplica RFC 1123 y
          # rechaza con 400 cualquier Host con guion bajo, de modo que la
          # sonda fallaba siempre, Traefik marcaba caido el unico backend y
          # la ruta publica devolvia 503 "no available server" aunque el
          # contenedor estuviese sano. `hostname` fija un Host valido sin
          # tocar el destino de la conexion. Es el unico backend afectado:
          # el resto responde 2xx/3xx con el Host con guion bajo.
          hostname: "{{ minecraft_stats.hostnames | first }}"
          interval: 15s
          timeout: 3s
    n8n:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://workloads_n8n:5678
        healthCheck:
          path: /healthz
          interval: 15s
          timeout: 3s
    openclaw:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://workloads_openclaw:18789
        healthCheck:
          path: /readyz
          interval: 15s
          timeout: 3s
    passbolt:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://workloads_passbolt:80
    portfolio-pablo:
      loadBalancer:
        servers:
          - url: http://workloads_portfolio-pablo:3000
        healthCheck:
          path: /
          interval: 15s
          timeout: 3s
    portfolio-alberto:
      loadBalancer:
        servers:
          - url: http://workloads_portfolio-alberto:3000
        healthCheck:
          path: /
          interval: 15s
          timeout: 3s
    shlink:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://workloads_shlink:8080
        healthCheck:
          path: /rest/health
          interval: 15s
          timeout: 3s

tls:
  options:
    default:
      minVersion: VersionTLS12
      sniStrict: true
