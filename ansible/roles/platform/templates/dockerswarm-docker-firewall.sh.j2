#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

readonly POLICY_CHAIN="DOCKERSWARM-INGRESS"

default_interface() {
  local family="$1"

  /usr/sbin/ip "-${family}" route show default 2>/dev/null |
    /usr/bin/awk 'NR == 1 { print $5 }'
}

configure_family() {
  local command_name="$1"
  local public_interface="$2"
  local crowdsec_position
  local insert_position

  [[ -n "${public_interface}" ]] || return 0

  "${command_name}" -w -n -L DOCKER-USER >/dev/null
  "${command_name}" -w -N "${POLICY_CHAIN}" 2>/dev/null || true
  "${command_name}" -w -F "${POLICY_CHAIN}"
  while "${command_name}" -w -D DOCKER-USER -j "${POLICY_CHAIN}" 2>/dev/null; do
    :
  done

  crowdsec_position="$(
    "${command_name}" -w -S DOCKER-USER |
      /usr/bin/awk '
        $1 == "-A" && $2 == "DOCKER-USER" {
          position += 1
          for (field = 3; field <= NF; field += 1) {
            if ($field == "-j" && $(field + 1) ~ /[Cc][Rr][Oo][Ww][Dd][Ss][Ee][Cc]/) {
              print position
              exit
            }
          }
        }
      '
  )"
  insert_position=1
  if [[ "${crowdsec_position}" =~ ^[1-9][0-9]*$ ]]; then
    insert_position=$((crowdsec_position + 1))
  fi
  "${command_name}" -w -I DOCKER-USER "${insert_position}" -j "${POLICY_CHAIN}"

  "${command_name}" -w -A "${POLICY_CHAIN}" \
    -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

{% for port in platform_public_tcp_ports | map("int") | sort %}
  "${command_name}" -w -A "${POLICY_CHAIN}" \
    -i "${public_interface}" \
    -p tcp \
    -m conntrack --ctdir ORIGINAL \
    --ctorigdstport {{ port }} \
    -j ACCEPT
{% endfor %}

  "${command_name}" -w -A "${POLICY_CHAIN}" \
    -i "${public_interface}" \
    -m conntrack --ctstate NEW \
    -j DROP
  "${command_name}" -w -A "${POLICY_CHAIN}" -j RETURN
}

readonly PUBLIC_INTERFACE="{{ platform_public_interface }}"
DEFAULT_IPV4_INTERFACE="$(default_interface 4)"
readonly DEFAULT_IPV4_INTERFACE

[[ "${DEFAULT_IPV4_INTERFACE}" == "${PUBLIC_INTERFACE}" ]] || {
  printf 'ERROR: expected default interface %s, found %s\n' \
    "${PUBLIC_INTERFACE}" "${DEFAULT_IPV4_INTERFACE}" >&2
  exit 1
}

configure_family /usr/sbin/iptables "${PUBLIC_INTERFACE}"

if /usr/sbin/ip6tables -w -n -L DOCKER-USER >/dev/null 2>&1 &&
  [[ "$(default_interface 6)" == "${PUBLIC_INTERFACE}" ]]; then
  configure_family /usr/sbin/ip6tables "${PUBLIC_INTERFACE}"
fi
