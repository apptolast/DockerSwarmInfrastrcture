---
# The AX web panel (images/ax-web), applied server-side by the ax_lab role
# only on drift, after AX (docs/AX_WEB.md). No Secret is rendered here: the
# owner creates ax-web-tls and ax-web-agent with scripts/ax-web-bootstrap.sh,
# and the role only checks their metadata. No RBAC and no Kubernetes API
# token: the panel talks to ax-server and atenet-router over gRPC only.
{% set web = ax_lab.web %}
{% set image = "localhost:5001/" ~ web.image.name ~ ":" ~ web.image.tag ~ "@" ~ web.image.digest %}
{% set panel_config %}
{"ax_server": "ax-server.ax-system.svc.cluster.local:8080", "router": "atenet-router.ate-system.svc.cluster.local:80", "atespace": "default", "agent_image": "localhost:5001/ax-agents:{{ ax_lab.ax.tag }}@{{ ax_lab.ax.images["ax-agents"] }}", "repo_hosts": [{% for host in web.repo_hosts %}"{{ host }}"{% if not loop.last %}, {% endif %}{% endfor %}], "origin": "{{ web.origin }}", "blackout": "{{ web.blackout_utc }}", "watchdog_lead_minutes": {{ web.watchdog_lead_minutes }}, "max_turns": {{ web.max_turns }}, "max_timeout_minutes": {{ web.max_timeout_minutes }}, "prompt_mode": "{{ web.prompt_mode }}", "token_directory": "/var/run/ax-web/agent", "token_key": "claude-oauth-token", "tls_cert_file": "/var/run/ax-web/tls/tls.crt", "tls_key_file": "/var/run/ax-web/tls/tls.key", "client_ca_file": "/var/run/ax-web/tls/client-ca.crt", "client_common_name": "{{ web.client_common_name }}", "listen": ":{{ web.port }}", "health_listen": ":{{ web.health_port }}"}
{% endset %}
# Pod Security Admission, «restricted» (kubernetes.io, Pod Security
# Standards), pinned to the cluster's minor version.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ web.namespace }}
  labels:
    com.apptolast.managed-by: ansible
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: v1.37
---
# Granted nothing: no Role, no binding and no mounted token.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ax-web
  namespace: {{ web.namespace }}
automountServiceAccountToken: false
---
# The panel's whole configuration (images/ax-web/internal/config): paths of
# the mounted Secrets, never their contents.
apiVersion: v1
kind: ConfigMap
metadata:
  name: ax-web
  namespace: {{ web.namespace }}
  labels:
    app.kubernetes.io/name: ax-web
    app.kubernetes.io/part-of: ax
data:
  config.json: |
    {{ panel_config | trim }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ax-web
  namespace: {{ web.namespace }}
  labels:
    app.kubernetes.io/name: ax-web
    app.kubernetes.io/part-of: ax
spec:
  replicas: 1
  # One panel at a time: it holds the only active run in memory.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: ax-web
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ax-web
      annotations:
        # The panel reads its configuration once: a new one rolls the pod.
        ax.apptolast.com/config-sha256: "{{ (panel_config | trim ~ '\n') | hash('sha256') }}"
    spec:
      serviceAccountName: ax-web
      automountServiceAccountToken: false
      enableServiceLinks: false
      # The panel cancels and cleans up its active run on SIGTERM (main.go).
      terminationGracePeriodSeconds: 120
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: ax-web
          image: {{ image }}
          imagePullPolicy: IfNotPresent
          args:
            - serve
            - --config
            - /etc/ax-web/config.json
          ports:
            - containerPort: {{ web.port }}
              name: https
            - containerPort: {{ web.health_port }}
              name: health
          resources:
            requests:
              cpu: 20m
              memory: 32Mi
            limits:
              cpu: 250m
              memory: 128Mi
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          # Plain HTTP on the probe port only; readiness ignores ax-server
          # (internal/web/health.go).
          readinessProbe:
            httpGet:
              path: /readyz
              port: {{ web.health_port }}
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /healthz
              port: {{ web.health_port }}
            initialDelaySeconds: 5
            periodSeconds: 20
          volumeMounts:
            - mountPath: /etc/ax-web
              name: config
              readOnly: true
            - mountPath: /var/run/ax-web/tls
              name: tls
              readOnly: true
            - mountPath: /var/run/ax-web/agent
              name: agent
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: ax-web
        - name: tls
          secret:
            secretName: ax-web-tls
            defaultMode: 0440
        - name: agent
          secret:
            secretName: ax-web-agent
            defaultMode: 0440
---
# One port, on the kind bridge only: the node's ports are not published on
# the host. Local keeps the forwarder's address and never hops.
apiVersion: v1
kind: Service
metadata:
  name: ax-web
  namespace: {{ web.namespace }}
  labels:
    app.kubernetes.io/name: ax-web
    app.kubernetes.io/part-of: ax
spec:
  type: NodePort
  externalTrafficPolicy: Local
  selector:
    app.kubernetes.io/name: ax-web
  ports:
    - name: https
      protocol: TCP
      port: {{ web.port }}
      targetPort: {{ web.port }}
      nodePort: {{ web.node_port }}
---
# Defence in depth, not relied upon (the panel requires Traefik's client
# certificate): no pod reaches the panel, and the panel reaches only DNS,
# ax-server and the atenet router. Policies apply to pod addresses, after
# the Service's translation (80 -> 8080 for the router). Ingress admits the
# panel's port only: the kubelet's probes of the health port come from the
# pod's node, which is always allowed (kubernetes.io, Network Policies).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ax-web
  namespace: {{ web.namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: ax-web
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
              - {{ web.pod_subnet }}
      ports:
        - protocol: TCP
          port: {{ web.port }}
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ax-system
          podSelector:
            matchLabels:
              app.kubernetes.io/name: ax-server
      ports:
        - protocol: TCP
          port: 8080
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ate-system
          podSelector:
            matchLabels:
              app: atenet-router
      ports:
        - protocol: TCP
          port: 8080
---
# The one exception to «no pod reaches ax-server» (ax-system.yaml): the
# panel, on its gRPC port. NetworkPolicies add up, so this only widens the
# ax-server policy by this peer.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ax-web-to-ax-server
  namespace: ax-system
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: ax-server
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ web.namespace }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: ax-web
      ports:
        - protocol: TCP
          port: 8080
