manage_firewall = false

# Server ID and MAC are audited, non-secret facts in config/platform.yml.

admin_cidrs = [
  "198.51.100.10/32",
  "2001:db8:1234::10/128",
]

# Opaque policy IDs are forbidden because their rules and priority are not IaC.
preserved_policy_ids = []

# Set true only after exporting every assigned policy and confirming that the
# fully modeled policy below may replace the complete assignment.
firewall_policy_inventory_confirmed = false

scp_ssh_public_keys = {
  platform = {
    name = "NetCupApptoLast"
    key  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAEXAMPLE"
  }
}
