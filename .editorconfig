root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.sh]
indent_size = 2

[*.go]
indent_style = tab

# Fijados byte a byte por su sha256 (images/ax/README.md): ningún editor debe
# tocar sus espacios ni su final.
[images/ax/google-ax-375.patch]
trim_trailing_whitespace = false

[images/ax/manifests/*.json]
insert_final_newline = false
