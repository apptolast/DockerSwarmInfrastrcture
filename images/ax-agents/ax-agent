#!/bin/sh
# Run an agent CLI inside an AX task sandbox.
#
# AX hands a task nothing but environment variables. Claude Code reads its
# subscription token from CLAUDE_CODE_OAUTH_TOKEN directly; Codex reads its
# ChatGPT sign-in from $CODEX_HOME/auth.json, so that file is written here
# from CODEX_AUTH_JSON_B64 before the variable is dropped from the
# environment the agent inherits.
set -eu

if [ -n "${CODEX_AUTH_JSON_B64:-}" ]; then
  codex_home="${CODEX_HOME:-${HOME}/.codex}"
  umask 077
  mkdir -p "${codex_home}"
  printf '%s' "${CODEX_AUTH_JSON_B64}" | base64 -d >"${codex_home}/auth.json"
  # Codex's own Linux sandbox is bubblewrap, which cannot bring up a
  # network namespace under gVisor ("bwrap: loopback: Failed RTM_NEWADDR");
  # the AX task sandbox is the outer boundary, the case its docs answer
  # with danger-full-access.
  if [ ! -f "${codex_home}/config.toml" ]; then
    printf '%s\n' \
      'cli_auth_credentials_store = "file"' \
      'sandbox_mode = "danger-full-access"' >"${codex_home}/config.toml"
  fi
  unset CODEX_AUTH_JSON_B64
fi

if [ "$#" -eq 0 ]; then
  echo "usage: ax-agent COMMAND [ARGS...]" >&2
  exit 64
fi
exec "$@"
